{
  "name": "robust-freecad-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade FreeCAD MCP server: precision-verified by measurement, token-efficient via Code Mode",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "robust-freecad-mcp": "dist/apps/mcp-server/src/server.js",
    "freecad-design": "dist/apps/design-agent/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/mcp-server/src/server.js",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "test:py": "python3 -m pytest -q tests/cad",
    "inspector": "npx @modelcontextprotocol/inspector node dist/apps/mcp-server/src/server.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "quickjs-emscripten": "0.32.0",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
